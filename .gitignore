!ios/Frameworks/facerecognitionsdk.framework/Headers/
!ios/Frameworks/facerecognitionsdk.framework/Modules/
!ios/Frameworks/facerecognitionsdk.framework/Info.plist
# SwiftPM / package Frameworks copy (synced when present)
ios/face_recognition_sdk/Frameworks/**/*.framework/**
ios/face_recognition_sdk/Frameworks/**/*.xcframework/**

